{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tagro.echo-os.component-contract/1",
  "title": "TAGRO ECHO OS Component Contract",
  "type": "object",
  "required": ["component_id","purpose","owner","status","inputs","outputs","state_owned","authority","dependencies","failure_behavior","security_boundary","observer_visibility","replacement_contract","acceptance_tests"],
  "properties": {
    "component_id": {"type":"string","minLength":1},
    "purpose": {"type":"string","minLength":1},
    "owner": {"type":"string","minLength":1},
    "status": {"enum":["idea","experiment","candidate","tested","admitted","active","superseded","retired"]},
    "inputs": {"type":"array","items":{"type":"string"}},
    "outputs": {"type":"array","items":{"type":"string"}},
    "state_owned": {"type":"array","items":{"type":"string"}},
    "authority": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "events_consumed": {"type":"array","items":{"type":"string"}},
    "events_emitted": {"type":"array","items":{"type":"string"}},
    "failure_behavior": {"type":"string","minLength":1},
    "security_boundary": {"type":"string","minLength":1},
    "observer_visibility": {"type":"string","minLength":1},
    "replacement_contract": {"type":"string","minLength":1},
    "acceptance_tests": {"type":"array","items":{"type":"string"},"minItems":1}
  },
  "additionalProperties": true
}
